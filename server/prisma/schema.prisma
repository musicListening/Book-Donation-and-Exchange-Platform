generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(uuid())
  name            String
  email           String            @unique
  password        String
  role            UserRole          @default(END_USER)
  points          Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  address         String?
  level           Int               @default(1)
  phoneNumber     String?
  CraftListing    CraftListing[]
  DonationRequest DonationRequest[]
  EventComment    EventComment[]
  EventLike       EventLike[]
  Order           Order[]
}

model BookCollection {
  id               String         @id
  title            String
  slug             String         @unique
  description      String?
  category         String
  type             CollectionType @default(STANDARD)
  stock            Int            @default(0)
  pointsRequired   Int
  isRare           Boolean        @default(false)
  minLevelRequired Int            @default(1)
  imageUrl         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  BookItem         BookItem[]
  OrderItem        OrderItem[]
}

model BookItem {
  id                   String           @id
  title                String
  author               String?
  isbn                 String?
  condition            BookCondition    @default(GOOD)
  language             String           @default("English")
  genre                String?
  publicationYear      Int?
  isDonated            Boolean          @default(false)
  donationRequestId    String?
  collectionId         String?
  isAvailable          Boolean          @default(true)
  addedToMarketplaceAt DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime
  BookCollection       BookCollection?  @relation(fields: [collectionId], references: [id])
  DonationRequest      DonationRequest? @relation(fields: [donationRequestId], references: [id])
  OrderItem            OrderItem[]
}

model CraftListing {
  id               String      @id
  userId           String
  title            String
  description      String
  imageUrl         String
  additionalImages String[]
  pointsPrice      Int
  status           CraftStatus @default(DRAFT)
  views            Int         @default(0)
  favorites        Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime
  User             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  OrderItem        OrderItem[]
}

model DeliveryUpdate {
  id        String      @id
  orderId   String
  status    OrderStatus
  note      String?
  updatedBy String?
  location  String?
  createdAt DateTime    @default(now())
  Order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DonationRequest {
  id             String       @id
  userId         String
  type           DonationType
  requestedCount Int
  verifiedCount  Int
  dropOffDate    DateTime?
  verifiedDate   DateTime?
  verifiedBy     String?
  pointsAwarded  Int          @default(0)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  BookItem       BookItem[]
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EventComment {
  id        String    @id
  postId    String
  userId    String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime
  EventPost EventPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EventLike {
  id        String    @id
  postId    String
  userId    String
  createdAt DateTime  @default(now())
  EventPost EventPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model EventPost {
  id           String         @id
  title        String
  description  String
  imageUrl     String?
  eventDate    DateTime
  venue        String?
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  EventComment EventComment[]
  EventLike    EventLike[]
}

model Order {
  id              String           @id
  userId          String
  totalPoints     Int
  cashAmount      Float?
  status          OrderStatus      @default(PENDING)
  processedAt     DateTime?
  atAirportAt     DateTime?
  arrivedAt       DateTime?
  deliveredAt     DateTime?
  shippingAddress String?
  phoneNumber     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  DeliveryUpdate  DeliveryUpdate[]
  User            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  OrderItem       OrderItem[]
}

model OrderItem {
  id             String          @id
  orderId        String
  collectionId   String?
  bookItemId     String?
  craftListingId String?
  quantity       Int             @default(1)
  pointsAtTime   Int
  cashAtTime     Float?
  createdAt      DateTime        @default(now())
  BookItem       BookItem?       @relation(fields: [bookItemId], references: [id])
  BookCollection BookCollection? @relation(fields: [collectionId], references: [id])
  CraftListing   CraftListing?   @relation(fields: [craftListingId], references: [id])
  Order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum UserRole {
  END_USER
  OPERATIONS_STAFF
  PLATFORM_ADMIN
  DELIVERY_PERSONNEL
  COMMUNITY_ADMIN
}

enum BookCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum CollectionType {
  STANDARD
  RARE
  MYSTERY
}

enum CraftStatus {
  DRAFT
  LISTED
  SOLD
  ARCHIVED
}

enum DonationType {
  SINGLE_BOOK
  COLLECTION
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}
