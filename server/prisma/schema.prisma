generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  END_USER
  OPERATIONS_STAFF
  PLATFORM_ADMIN
  DELIVERY_PERSONNEL
  COMMUNITY_ADMIN
}

model User {
  id          String            @id @default(uuid())
  name        String
  email       String            @unique
  password    String
  role        UserRole          @default(END_USER)
  points      Int               @default(0)
  level       Int               @default(1)         // NEW: For gamification
  phoneNumber String?                               // NEW: For delivery contact
  address     String?                               // NEW: For delivery destination
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}