generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(uuid())
  name          String
  email         String            @unique
  password      String
  role          UserRole          @default(END_USER)
  points        Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  address       String?
  level         Int               @default(1)
  phoneNumber   String?
  craftListings CraftListing[]
  donations     DonationRequest[]
  comments      EventComment[]
  likes         EventLike[]
  orders        Order[]
}

model DonationRequest {
  id             String       @id @default(uuid())
  userId         String
  type           DonationType
  requestedCount Int
  verifiedCount  Int
  dropOffDate    DateTime?
  verifiedDate   DateTime?
  verifiedBy     String?
  pointsAwarded  Int          @default(0)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  books          BookItem[]
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BookCollection {
  id               String         @id @default(uuid())
  title            String
  slug             String         @unique
  description      String?
  category         String
  type             CollectionType @default(STANDARD)
  stock            Int            @default(0)
  pointsRequired   Int
  isRare           Boolean        @default(false)
  minLevelRequired Int            @default(1)
  imageUrl         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  books            BookItem[]
  orderItems       OrderItem[]
}

model BookItem {
  id                   String           @id @default(uuid())
  title                String
  author               String?
  isbn                 String?
  condition            BookCondition    @default(GOOD)
  language             String           @default("English")
  genre                String?
  publicationYear      Int?
  isDonated            Boolean          @default(false)
  donationRequestId    String?
  collectionId         String?
  isAvailable          Boolean          @default(true)
  addedToMarketplaceAt DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  collection           BookCollection?  @relation(fields: [collectionId], references: [id])
  donationRequest      DonationRequest? @relation(fields: [donationRequestId], references: [id])
  orderItems           OrderItem[]
}

model CraftListing {
  id               String      @id @default(uuid())
  userId           String
  title            String
  description      String
  imageUrl         String
  additionalImages String[]
  pointsPrice      Int
  status           CraftStatus @default(DRAFT)
  views            Int         @default(0)
  favorites        Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
}

model Order {
  id              String           @id @default(uuid())
  userId          String
  totalPoints     Int
  cashAmount      Float?
  status          OrderStatus      @default(PENDING)
  processedAt     DateTime?
  atAirportAt     DateTime?
  arrivedAt       DateTime?
  deliveredAt     DateTime?
  shippingAddress String?
  phoneNumber     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deliveryUpdates DeliveryUpdate[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
}

model OrderItem {
  id             String          @id @default(uuid())
  orderId        String
  collectionId   String?
  bookItemId     String?
  craftListingId String?
  quantity       Int             @default(1)
  pointsAtTime   Int
  cashAtTime     Float?
  createdAt      DateTime        @default(now())
  bookItem       BookItem?       @relation(fields: [bookItemId], references: [id])
  collection     BookCollection? @relation(fields: [collectionId], references: [id])
  craftListing   CraftListing?   @relation(fields: [craftListingId], references: [id])
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DeliveryUpdate {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  updatedBy String?
  location  String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model EventPost {
  id          String         @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  eventDate   DateTime
  venue       String?
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  comments    EventComment[]
  likes       EventLike[]
}

model EventComment {
  id        String    @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  post      EventPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EventLike {
  id        String    @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime  @default(now())
  post      EventPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

enum UserRole {
  END_USER
  OPERATIONS_STAFF
  PLATFORM_ADMIN
  DELIVERY_PERSONNEL
  COMMUNITY_ADMIN
}

enum DonationType {
  SINGLE_BOOK
  COLLECTION
}

enum BookCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum CollectionType {
  STANDARD
  RARE
  MYSTERY
}

enum CraftStatus {
  DRAFT
  LISTED
  SOLD
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}
