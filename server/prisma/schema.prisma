generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                              String             @id @default(uuid())
  name                                            String
  email                                           String             @unique
  password                                        String
  role                                            UserRole           @default(END_USER)
  points                                          Int                @default(0)
  createdAt                                       DateTime           @default(now())
  updatedAt                                       DateTime           @updatedAt
  address                                         String?
  level                                           Int                @default(1)
  phoneNumber                                     String?
  isActive                                        Boolean            @default(true)
  status                                          String?            @default("AVAILABLE")
  activeOrders                                    Int?               @default(0)
  booksDonated                                    Int                @default(0)
  profileImage                                    String?
  AuditLog_AuditLog_actorUserIdToUser             AuditLog[]         @relation("AuditLog_actorUserIdToUser")
  AuditLog_AuditLog_targetUserIdToUser            AuditLog[]         @relation("AuditLog_targetUserIdToUser")
  craftListings                                   CraftListing[]
  donations                                       DonationRequest[]
  comments                                        EventComment[]
  likes                                           EventLike[]
  loginLogs                                       LoginLog[]
  MysteryBox_MysteryBox_assignedByToUser          MysteryBox[]       @relation("MysteryBox_assignedByToUser")
  MysteryBox_MysteryBox_userIdToUser              MysteryBox[]       @relation("MysteryBox_userIdToUser")
  Notification                                    Notification[]
  orders                                          Order[]
  Order_Order_driverIdToUser                      Order[]            @relation("Order_driverIdToUser")
  PlatformReview                                  PlatformReview?
  PointTransaction_PointTransaction_staffIdToUser PointTransaction[] @relation("PointTransaction_staffIdToUser")
  PointTransaction_PointTransaction_userIdToUser  PointTransaction[] @relation("PointTransaction_userIdToUser")
  Shipment                                        Shipment[]
  SystemConfig                                    SystemConfig[]
  Task                                            Task[]

  @@index([role])
  @@index([isActive])
  @@index([role, isActive])
  @@index([level, points])
  @@index([createdAt])
}

model DeletedUser {
  id                String   @id @default(uuid())
  originalId        String
  name              String
  email             String
  role              UserRole @default(END_USER)
  points            Int      @default(0)
  level             Int      @default(1)
  phoneNumber       String?
  address           String?
  isActive          Boolean  @default(true)
  status            String?
  activeOrders      Int?     @default(0)
  createdAt         DateTime
  deletedAt         DateTime @default(now())
  deletedBy         String?
  originalCreatedAt DateTime
}

model DonationRequest {
  id                   String             @id @default(uuid())
  userId               String
  type                 DonationType
  requestedCount       Int
  verifiedCount        Int
  dropOffDate          DateTime?
  verifiedDate         DateTime?
  verifiedBy           String?
  pointsAwarded        Int                @default(0)
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  collectionName       String?
  category             String?
  awardedMysteryBox    Boolean            @default(false)
  condition            String?
  isCollectionComplete Boolean            @default(false)
  staffNotes           String?
  status               String             @default("PENDING")
  donationImages       String[]
  timeSlot             String?
  books                BookItem[]
  crafts               CraftListing[]
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  Notification         Notification[]
  PointTransaction     PointTransaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model BookCollection {
  id               String         @id @default(uuid())
  title            String
  slug             String         @unique
  description      String?
  category         String
  type             CollectionType @default(STANDARD)
  stock            Int            @default(0)
  pointsRequired   Int
  isRare           Boolean        @default(false)
  minLevelRequired Int            @default(1)
  imageUrl         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  cashPrice        Float?
  books            BookItem[]
  orderItems       OrderItem[]

  @@index([category])
  @@index([type])
  @@index([stock])
  @@index([createdAt])
}

model BookItem {
  id                   String           @id @default(uuid())
  title                String
  author               String?
  isbn                 String?
  condition            BookCondition    @default(GOOD)
  language             String           @default("English")
  genre                String?
  publicationYear      Int?
  isDonated            Boolean          @default(false)
  donationRequestId    String?
  collectionId         String?
  isAvailable          Boolean          @default(true)
  addedToMarketplaceAt DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  mysteryBoxId         String?
  imageUrl             String?
  pointsPrice          Int?
  collection           BookCollection?  @relation(fields: [collectionId], references: [id])
  donationRequest      DonationRequest? @relation(fields: [donationRequestId], references: [id])
  MysteryBox           MysteryBox?      @relation(fields: [mysteryBoxId], references: [id])
  orderItems           OrderItem[]
}

model CraftListing {
  id                String           @id @default(uuid())
  userId            String
  title             String
  description       String
  imageUrl          String
  additionalImages  String[]
  pointsPrice       Int
  status            CraftStatus      @default(DRAFT)
  views             Int              @default(0)
  favorites         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  donationRequestId String?
  donationRequest   DonationRequest? @relation(fields: [donationRequestId], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
}

model Order {
  id                        String             @id @default(uuid())
  userId                    String
  totalPoints               Int
  cashAmount                Float?
  status                    OrderStatus        @default(PENDING)
  processedAt               DateTime?
  atAirportAt               DateTime?
  arrivedAt                 DateTime?
  deliveredAt               DateTime?
  shippingAddress           String?
  phoneNumber               String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  driverId                  String?
  driverName                String?
  deliveryUpdates           DeliveryUpdate[]
  Notification              Notification[]
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  User_Order_driverIdToUser User?              @relation("Order_driverIdToUser", fields: [driverId], references: [id], onUpdate: NoAction, map: "fk_order_driver")
  items                     OrderItem[]
  PointTransaction          PointTransaction[]

  @@index([userId])
  @@index([status])
  @@index([driverId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id             String          @id @default(uuid())
  orderId        String
  collectionId   String?
  bookItemId     String?
  craftListingId String?
  quantity       Int             @default(1)
  pointsAtTime   Int
  cashAtTime     Float?
  createdAt      DateTime        @default(now())
  bookItem       BookItem?       @relation(fields: [bookItemId], references: [id])
  collection     BookCollection? @relation(fields: [collectionId], references: [id])
  craftListing   CraftListing?   @relation(fields: [craftListingId], references: [id])
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([collectionId])
  @@index([bookItemId])
  @@index([craftListingId])
}

model DeliveryUpdate {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  updatedBy String?
  location  String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model EventPost {
  id          String         @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  eventDate   DateTime
  venue       String?
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  comments    EventComment[]
  likes       EventLike[]
}

model EventComment {
  id        String    @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  post      EventPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EventLike {
  id        String    @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime  @default(now())
  post      EventPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model AuditLog {
  id                               String      @id @default(dbgenerated("gen_random_uuid()"))
  actorUserId                      String
  targetUserId                     String?
  action                           AuditAction
  details                          String
  metadata                         Json?
  createdAt                        DateTime    @default(now())
  User_AuditLog_actorUserIdToUser  User        @relation("AuditLog_actorUserIdToUser", fields: [actorUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User_AuditLog_targetUserIdToUser User?       @relation("AuditLog_targetUserIdToUser", fields: [targetUserId], references: [id], onUpdate: NoAction)
}

model Notification {
  id                String           @id @default(dbgenerated("gen_random_uuid()"))
  userId            String
  type              NotificationType
  title             String
  message           String
  isRead            Boolean          @default(false)
  relatedOrderId    String?
  relatedDonationId String?
  createdAt         DateTime         @default(now())
  DonationRequest   DonationRequest? @relation(fields: [relatedDonationId], references: [id], onUpdate: NoAction)
  Order             Order?           @relation(fields: [relatedOrderId], references: [id], onUpdate: NoAction)
  User              User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model PointTransaction {
  id                                  String           @id @default(dbgenerated("gen_random_uuid()"))
  userId                              String
  type                                TransactionType
  amount                              Int
  description                         String
  relatedDonationId                   String?
  relatedOrderId                      String?
  staffId                             String?
  createdAt                           DateTime         @default(now())
  DonationRequest                     DonationRequest? @relation(fields: [relatedDonationId], references: [id], onUpdate: NoAction)
  Order                               Order?           @relation(fields: [relatedOrderId], references: [id], onUpdate: NoAction)
  User_PointTransaction_staffIdToUser User?            @relation("PointTransaction_staffIdToUser", fields: [staffId], references: [id], onUpdate: NoAction)
  User_PointTransaction_userIdToUser  User             @relation("PointTransaction_userIdToUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Level {
  id               Int      @id @default(autoincrement())
  level            Int      @unique
  name             String
  minPoints        Int
  reward           String?
  mysteryBoxUnlock String?
  mysteryBoxPoints Int?
  mysteryBoxBooks  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SystemConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @default(now())
  User        User?    @relation(fields: [updatedBy], references: [id], onUpdate: NoAction)
}

model Shipment {
  id         String   @id
  orderId    String   @unique
  recipient  String
  location   String
  items      String
  status     String
  lastUpdate String
  driver     String
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id        String   @id
  taskId    String   @unique
  donor     String
  location  String
  volume    String
  date      String
  status    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MysteryBox {
  id          String           @id @default(uuid())
  userId      String
  level       Int
  status      MysteryBoxStatus @default(UNCLAIMED)
  assignedBy  String?
  assignedAt  DateTime         @default(now())
  claimedAt   DateTime?
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  books       BookItem[]
  staff       User?            @relation("MysteryBox_assignedByToUser", fields: [assignedBy], references: [id])
  user        User             @relation("MysteryBox_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformReview {
  id         String   @id @default(uuid())
  userId     String   @unique
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isApproved Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  action    AuditAction
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())
  User      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  END_USER
  OPERATIONS_STAFF
  PLATFORM_ADMIN
  DELIVERY_PERSONNEL
  COMMUNITY_ADMIN
}

enum DonationType {
  SINGLE_BOOK
  COLLECTION
}

enum BookCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum CollectionType {
  STANDARD
  RARE
  MYSTERY
}

enum CraftStatus {
  DRAFT
  LISTED
  SOLD
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum AuditAction {
  POINT_ADJUSTMENT
  USER_DEACTIVATION
  USER_REACTIVATION
  ROLE_CHANGE
  DONATION_VERIFICATION
  ORDER_CANCELLATION
  SYSTEM_CONFIG_CHANGE
  LOGIN
  LOGOUT
}

enum NotificationType {
  ORDER_UPDATE
  SALE_CONFIRMATION
  DELIVERY_UPDATE
  LEVEL_UP
  POINT_ADJUSTMENT
  SYSTEM
  DISPUTE_UPDATE
  MYSTERY_BOX_REWARD
}

enum TransactionType {
  EARNED_DONATION
  EARNED_SALE
  EARNED_BONUS
  SPENT_BOOK
  SPENT_CRAFT
  STAFF_ADJUSTMENT
  REFUND
}

enum MysteryBoxStatus {
  UNCLAIMED
  CLAIMED
}
