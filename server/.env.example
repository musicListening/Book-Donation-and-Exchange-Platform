# Database connection - use your role-specific credentials from Neon
# Get your connection string from: https://console.neon.tech → Connection Details
DATABASE_URL="postgresql://<role>:<password>@<host>/<dbname>?sslmode=require"

# JWT secret for authentication
JWT_SECRET=your_jwt_secret_here

# Cloudinary configuration for image uploads
# Get your credentials from: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
